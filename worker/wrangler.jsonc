// armada's Worker (src/worker.ts). `armada deploy` deploys it with the account id written into a copy of this file;
// nothing here names an account.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "armada",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Both on the `durable_object` policy: no image, instance type or cap here. Each start names what it starts from
  // (a recipe's base image, or an environment snapshot) and its instance; running instances count against the
  // account's limits, and ArmadaFleet keeps this deployment's jobs under its FLEET_VCPUS.
  "containers": [
    { "class_name": "ArmadaVessel", "scheduling_policy": "durable_object" },
    { "class_name": "ArmadaPreparer", "scheduling_policy": "durable_object" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "JOB", "class_name": "ArmadaJob" },
      { "name": "VESSEL", "class_name": "ArmadaVessel" },
      { "name": "ENVIRONMENTS", "class_name": "ArmadaEnvironments" },
      { "name": "PREPARER", "class_name": "ArmadaPreparer" },
      { "name": "TIMINGS", "class_name": "ArmadaTimings" },
      { "name": "FLEET", "class_name": "ArmadaFleet" },
      { "name": "TASKS", "class_name": "ArmadaTasks" },
      { "name": "SECRETS", "class_name": "ArmadaSecrets" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ArmadaJob", "ArmadaVessel", "ArmadaEnvironments", "ArmadaPreparer", "ArmadaTimings", "ArmadaFleet"] },
    { "tag": "v2", "new_sqlite_classes": ["ArmadaTasks"] },
    { "tag": "v3", "new_sqlite_classes": ["ArmadaSecrets"] }
  ],
  // The dashboard (worker/dashboard), built here by `armada deploy` (src/dashboard.ts) and served under /ui/ before the
  // Worker runs; every other path runs the Worker.
  "assets": { "directory": "../dist/dashboard" },
  "vars": { "FLEET_VCPUS": "1500" },
  "version_metadata": { "binding": "VERSION" },
  // Packs and job artifacts expire after 7 days (lifecycle rules `armada deploy` adds); CI verdicts are kept, and a
  // pushed bundle while a task points to it.
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "armada-artifacts" }]
}
