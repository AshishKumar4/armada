{
  "name": "armada",
  "environment": {
    "setup": "ci/setup.sh",
    "install": "ci/install.sh",
    "key": ["bun.lock", "package.json", "lean/lean-toolchain", "lean/lakefile.lean"]
  },
  "pool": 2,
  "size": "auto",
  "env": { "ELAN_HOME": "/opt/elan" },
  "plan": { "command": ["echo", "{\"include\": [{\"name\": \"test\"}, {\"name\": \"typecheck\"}, {\"name\": \"proofs\"}, {\"name\": \"relay\", \"gang\": 2}]}"] },
  "task": { "command": ["bun", "run", "{name}"], "verdict": false, "timeout": 600 }
}
