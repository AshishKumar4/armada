{
  "name": "armada",
  "version": "0.1.0",
  "description": "Run a command over many inputs at once, on Cloudflare Containers.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "bin": {
    "armada": "src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p worker && tsc --noEmit -p worker/tests",
    "test": "bun test tests/ worker/tests/",
    "relay": "python3 ci/relay.py",
    "proofs": "sh ci/proofs.sh"
  },
  "dependencies": {
    "valibot": "1.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260930.2",
    "@types/bun": "latest",
    "typescript": "7.0.2",
    "wrangler": "4.145.0"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
